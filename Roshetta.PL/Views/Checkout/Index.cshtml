@model Roshetta.BLL.DTOs.CheckoutDto
@{
    ViewData["Title"] = "Checkout";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Cart" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Cart</a></li>
            <li class="breadcrumb-item active" aria-current="page" style="color: var(--text-secondary);">Checkout</li>
        </ol>
    </nav>
    <h1 class="h3 fw-bold mb-4" style="color: var(--dark-navy);">
        Checkout & Delivery
    </h1>

    <form asp-controller="Checkout" asp-action="PlaceOrder" method="post" id="checkoutForm">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <!-- Left: Delivery Information & Payment Method -->
            <div class="col-lg-7">
                <!-- Validation Summary -->
                <div asp-validation-summary="All" class="text-danger small mb-3"></div>

                <!-- 1. Contact & Delivery Address Card -->
                <div class="rosetta-card mb-4">
                    <div class="rosetta-card-header d-flex align-items-center gap-2">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 26px; height: 26px; background-color: var(--primary-blue); font-size: 0.85rem; font-weight: bold;">1</span>
                        <h2 class="h5 fw-bold mb-0" style="color: var(--dark-navy);">Delivery Address in Egypt</h2>
                    </div>
                    <div class="rosetta-card-body">
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label asp-for="FullName" class="form-label-rosetta"></label>
                                <input asp-for="FullName" class="form-control form-control-rosetta" placeholder="e.g. David Samir" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Phone" class="form-label-rosetta"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted" style="border-color: var(--border-color); font-size: 0.9rem;">+20</span>
                                    <input asp-for="Phone" class="form-control form-control-rosetta border-start-0" placeholder="1012345678" />
                                </div>
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="Governorate" class="form-label-rosetta"></label>
                                <select asp-for="Governorate" class="form-select form-control-rosetta">
                                    <option value="Cairo">Cairo (القاهرة)</option>
                                    <option value="Giza">Giza (الجيزة)</option>
                                    <option value="Alexandria">Alexandria (الإسكندرية)</option>
                                    <option value="Qalyubia">Qalyubia (القليوبية)</option>
                                    <option value="Sharqia">Sharqia (الشرقية)</option>
                                    <option value="Gharbia">Gharbia (الغربية)</option>
                                    <option value="Dakahlia">Dakahlia (الدقهلية)</option>
                                </select>
                                <span asp-validation-for="Governorate" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="City" class="form-label-rosetta"></label>
                                <input asp-for="City" class="form-control form-control-rosetta" placeholder="e.g. Zamalek, Maadi, Dokki..." />
                                <span asp-validation-for="City" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Street" class="form-label-rosetta"></label>
                                <input asp-for="Street" class="form-control form-control-rosetta" placeholder="e.g. 26th of July Corridor / Street name" />
                                <span asp-validation-for="Street" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="Building" class="form-label-rosetta"></label>
                                <input asp-for="Building" class="form-control form-control-rosetta" placeholder="e.g. Building 14, Floor 4, Apt 4B" />
                                <span asp-validation-for="Building" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="DeliveryNotes" class="form-label-rosetta"></label>
                                <textarea asp-for="DeliveryNotes" class="form-control form-control-rosetta" rows="2" placeholder="Optional notes for courier (e.g. leave with reception, call upon arrival)"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2. Payment Method Card -->
                <div class="rosetta-card mb-4">
                    <div class="rosetta-card-header d-flex align-items-center gap-2">
                        <span class="rounded-circle d-inline-flex align-items-center justify-content-center text-white" style="width: 26px; height: 26px; background-color: var(--primary-blue); font-size: 0.85rem; font-weight: bold;">2</span>
                        <h2 class="h5 fw-bold mb-0" style="color: var(--dark-navy);">Payment Method</h2>
                    </div>
                    <div class="rosetta-card-body">
                        <!-- Cash on Delivery (Standard) -->
                        <div class="p-3 mb-3 rounded-3 border d-flex align-items-center justify-content-between" style="border-color: var(--primary-blue) !important; background-color: var(--primary-blue-subtle);">
                            <div class="form-check d-flex align-items-center gap-3 mb-0">
                                <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="Cash on Delivery" id="payCod" checked />
                                <label class="form-check-label d-flex align-items-center gap-3 cursor-pointer" for="payCod">
                                    <i class="bi bi-cash-stack fs-3" style="color: var(--primary-blue);"></i>
                                    <div>
                                        <div class="fw-bold" style="color: var(--dark-navy);">Cash on Delivery (COD)</div>
                                        <div class="text-secondary small">Pay safely in cash or POS card upon receiving your order from the courier.</div>
                                    </div>
                                </label>
                            </div>
                            <span class="badge" style="background-color: var(--soft-green); color: #166534;">Recommended</span>
                        </div>

                        <!-- Card in Test Mode -->
                        <div class="p-3 rounded-3 border d-flex align-items-center justify-content-between opacity-75" style="border-color: var(--border-color); background-color: #fff;">
                            <div class="form-check d-flex align-items-center gap-3 mb-0">
                                <input class="form-check-input mt-0" type="radio" asp-for="PaymentMethod" value="Online Card" id="payCard" disabled />
                                <label class="form-check-label text-muted" for="payCard">
                                    <div class="fw-semibold">Credit / Debit Card (Meeza, Visa, Mastercard)</div>
                                    <div class="small">Online payment gateway (Coming in Stretch Release).</div>
                                </label>
                            </div>
                            <span class="badge bg-secondary text-white small">Coming Soon</span>
                        </div>
                    </div>
                </div>

                @if (Model.Cart?.HasRxItems == true)
                {
                    <!-- Pharmacist Oversight Notice -->
                    <div class="rosetta-card p-3 d-flex align-items-start gap-3" style="background-color: #fefce8; border-color: #fde68a;">
                        <i class="bi bi-shield-check fs-3 text-warning"></i>
                        <div>
                            <div class="fw-bold" style="color: #854d0e;">Prescription Verification Step</div>
                            <div class="small text-secondary">
                                This order contains prescription medication. Once placed, your order will transition to <strong>Pharmacist Review</strong>. Our licensed pharmacist will contact you if prescription confirmation is required.
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Right: Order Review & Confirmation -->
            <div class="col-lg-5">
                <div class="order-summary-box">
                    <h2 class="h5 fw-bold mb-3" style="color: var(--dark-navy);">Order Review</h2>

                    <!-- Items List Preview -->
                    @if (Model.Cart?.Items != null)
                    {
                        <div class="mb-3 max-vh-50 overflow-auto pe-1">
                            @foreach (var item in Model.Cart.Items)
                            {
                                <div class="d-flex justify-content-between align-items-center py-2 border-bottom border-light">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-primary" style="width: 32px; height: 32px; background-color: var(--primary-blue-subtle);">
                                            <i class="bi bi-capsule small"></i>
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark small">@item.ProductName</div>
                                            <div class="text-muted small">Qty: @item.Quantity &times; EGP @item.UnitPrice.ToString("N2")</div>
                                        </div>
                                    </div>
                                    <div class="fw-bold small" style="color: var(--primary-blue);">
                                        EGP @item.LineTotal.ToString("N2")
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    <div class="summary-row">
                        <span>Items Subtotal</span>
                        <span class="fw-semibold text-dark">EGP @(Model.Cart?.Subtotal.ToString("N2") ?? "0.00")</span>
                    </div>

                    <div class="summary-row">
                        <span>Delivery Fee</span>
                        <span class="fw-semibold">
                            @if (Model.Cart?.DeliveryFee == 0)
                            {
                                <span class="text-success fw-bold">FREE</span>
                            }
                            else
                            {
                                <span>EGP @(Model.Cart?.DeliveryFee.ToString("N2") ?? "0.00")</span>
                            }
                        </span>
                    </div>

                    <div class="summary-row total-row">
                        <span>Total Due</span>
                        <span style="color: var(--primary-blue);">EGP @(Model.Cart?.Total.ToString("N2") ?? "0.00")</span>
                    </div>

                    <div class="mt-4">
                        <button type="submit" class="btn btn-rosetta-primary w-100 py-3 fs-6">
                            <i class="bi bi-bag-check me-2"></i> Confirm & Place Order
                        </button>
                    </div>

                    <div class="text-center mt-3">
                        <a asp-controller="Cart" asp-action="Index" class="small text-secondary text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i> Edit Cart Items
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
