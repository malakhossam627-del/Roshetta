@model Roshetta.BLL.DTOs.OrderDetailsDto
@{
    ViewData["Title"] = "Order Details - " + Model.OrderNumber;
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page" style="color: var(--text-secondary);">@Model.OrderNumber</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0" style="color: var(--dark-navy);">Order Details</h1>
                <!-- Status Badge -->
                @if (Model.Status == "Placed")
                {
                    <span class="rosetta-badge badge-status-placed"><i class="bi bi-bag-check"></i> Placed</span>
                }
                else if (Model.Status.Contains("Review"))
                {
                    <span class="rosetta-badge badge-status-review"><i class="bi bi-clipboard-pulse"></i> Rx Review</span>
                }
                else if (Model.Status == "Confirmed")
                {
                    <span class="rosetta-badge badge-status-confirmed"><i class="bi bi-check-circle"></i> Confirmed</span>
                }
                else if (Model.Status == "Packed")
                {
                    <span class="rosetta-badge badge-status-packed"><i class="bi bi-box-seam"></i> Packed</span>
                }
                else if (Model.Status.Contains("Delivery") || Model.Status.Contains("Out"))
                {
                    <span class="rosetta-badge badge-status-delivery"><i class="bi bi-truck"></i> Out for Delivery</span>
                }
                else if (Model.Status == "Delivered")
                {
                    <span class="rosetta-badge badge-status-delivered"><i class="bi bi-check-all"></i> Delivered</span>
                }
                else
                {
                    <span class="rosetta-badge badge-status-cancelled">@Model.Status</span>
                }
            </div>
            <div class="text-secondary small">
                Order <strong class="text-dark">#@Model.OrderNumber</strong> &bull; Placed on @Model.OrderDate.ToString("dd MMMM yyyy, hh:mm tt")
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Track" asp-route-id="@Model.OrderId" class="btn btn-rosetta-primary btn-sm">
                <i class="bi bi-geo-alt-fill me-1"></i> Track Order Live
            </a>

            <form asp-action="Reorder" asp-route-id="@Model.OrderId" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-rosetta-secondary btn-sm">
                    <i class="bi bi-arrow-repeat me-1"></i> Reorder All
                </button>
            </form>

            <a asp-action="Index" class="btn btn-rosetta-outline btn-sm">
                <i class="bi bi-arrow-left me-1"></i> Back to Orders
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Items Table & Activity Log -->
        <div class="col-lg-8">
            <!-- Order Items Card -->
            <div class="rosetta-card mb-4 overflow-hidden">
                <div class="rosetta-card-header d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-bold mb-0" style="color: var(--dark-navy);">
                        <i class="bi bi-capsule me-2 text-primary"></i>Medications in this Order (@Model.Items.Count)
                    </h2>
                    <span class="small text-secondary">Snapshot at Purchase</span>
                </div>
                <div class="rosetta-card-body p-0">
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead style="background-color: var(--bg-app); border-bottom: 1px solid var(--border-color);">
                                <tr>
                                    <th class="ps-4 py-3 text-secondary small fw-bold">ITEM</th>
                                    <th class="py-3 text-secondary small fw-bold">UNIT PRICE</th>
                                    <th class="py-3 text-center text-secondary small fw-bold">QUANTITY</th>
                                    <th class="pe-4 py-3 text-end text-secondary small fw-bold">LINE TOTAL</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="border-bottom border-light">
                                        <td class="ps-4 py-3">
                                            <div class="fw-bold text-dark">@item.ProductName</div>
                                            <div class="text-muted small">
                                                @if (!string.IsNullOrEmpty(item.Strength))
                                                {
                                                    <span>@item.Strength</span>
                                                }
                                                @if (!string.IsNullOrEmpty(item.DosageForm))
                                                {
                                                    <span>&bull; @item.DosageForm</span>
                                                }
                                            </div>
                                        </td>
                                        <td class="py-3 fw-semibold text-secondary">
                                            EGP @item.UnitPrice.ToString("N2")
                                        </td>
                                        <td class="py-3 text-center fw-bold text-dark">
                                            @item.Quantity
                                        </td>
                                        <td class="pe-4 py-3 text-end fw-bold" style="color: var(--primary-blue);">
                                            EGP @item.LineTotal.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Lifecycle / Status History Log -->
            <div class="rosetta-card">
                <div class="rosetta-card-header">
                    <h2 class="h6 fw-bold mb-0" style="color: var(--dark-navy);">
                        <i class="bi bi-clock-history me-2 text-primary"></i>Order Status History & Audit Log
                    </h2>
                </div>
                <div class="rosetta-card-body">
                    <div class="tracking-stepper">
                        @foreach (var step in Model.Timeline)
                        {
                            <div class="stepper-item @(step.IsCompleted ? "completed" : "") @(step.IsCurrent ? "current" : "")">
                                <div class="stepper-icon">
                                    <i class="bi @step.IconClass"></i>
                                </div>
                                <div class="stepper-content">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <div class="stepper-title">@step.Title</div>
                                        @if (step.Timestamp.HasValue)
                                        {
                                            <div class="stepper-time">@step.Timestamp.Value.ToString("dd MMM, hh:mm tt")</div>
                                        }
                                    </div>
                                    <div class="stepper-desc">@step.Description</div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Billing & Delivery Summary -->
        <div class="col-lg-4">
            <!-- Payment & Financials -->
            <div class="order-summary-box mb-4">
                <h2 class="h6 fw-bold mb-3" style="color: var(--dark-navy);">Payment Summary</h2>

                <div class="summary-row">
                    <span>Items Subtotal</span>
                    <span class="fw-semibold text-dark">EGP @Model.Subtotal.ToString("N2")</span>
                </div>

                <div class="summary-row">
                    <span>Delivery Fee</span>
                    <span class="fw-semibold">
                        @if (Model.DeliveryFee == 0)
                        {
                            <span class="text-success fw-bold">FREE</span>
                        }
                        else
                        {
                            <span>EGP @Model.DeliveryFee.ToString("N2")</span>
                        }
                    </span>
                </div>

                <div class="summary-row total-row">
                    <span>Total Amount</span>
                    <span style="color: var(--primary-blue);">EGP @Model.TotalAmount.ToString("N2")</span>
                </div>

                <div class="mt-3 pt-3 border-top border-light small">
                    <div class="d-flex justify-content-between mb-1">
                        <span class="text-secondary">Method:</span>
                        <span class="fw-semibold text-dark">@Model.PaymentMethod</span>
                    </div>
                    <div class="d-flex justify-content-between">
                        <span class="text-secondary">Status:</span>
                        <span class="badge @(Model.PaymentStatus == "Completed" ? "bg-success" : "bg-warning text-dark")">@Model.PaymentStatus</span>
                    </div>
                </div>
            </div>

            <!-- Delivery Address Card -->
            <div class="rosetta-card mb-4 p-3">
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-light">
                    <i class="bi bi-geo-alt-fill text-danger"></i>
                    <h3 class="h6 fw-bold mb-0 text-dark">Delivery Address</h3>
                </div>
                <div class="small fw-semibold text-dark mb-1">@Model.CustomerName</div>
                <div class="small text-secondary mb-1">@Model.DeliveryAddress</div>
                <div class="small text-muted"><i class="bi bi-telephone me-1"></i> @Model.CustomerPhone</div>
            </div>

            <!-- Pharmacy Card -->
            <div class="rosetta-card p-3">
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-light">
                    <i class="bi bi-hospital text-primary"></i>
                    <h3 class="h6 fw-bold mb-0 text-dark">Fulfilling Pharmacy</h3>
                </div>
                <div class="small fw-semibold text-dark mb-1">@Model.PharmacyName</div>
                <div class="small text-secondary mb-1">Official Licensed Healthcare Provider</div>
                @if (!string.IsNullOrEmpty(Model.PharmacyPhone))
                {
                    <div class="small text-muted"><i class="bi bi-telephone me-1"></i> @Model.PharmacyPhone</div>
                }
            </div>
        </div>
    </div>
</div>
