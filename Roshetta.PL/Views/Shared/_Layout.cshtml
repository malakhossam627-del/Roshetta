@{ var userName = "Guest"; }
@{
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Roshetta | Smart Online Pharmacy</title>

    <!-- Google Fonts: Grand Hotel (Logo) & Figtree (Unified UI) -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Grand+Hotel&family=Figtree:ital,wght@0,300..900;1,300..900&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- Roshetta Theme Styles -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- Top Navigation Bar -->
    <nav class="navbar navbar-expand-lg rosetta-navbar">
        <div class="container">
            <!-- Brand Logo with Grand Hotel Font -->
            <a class="brand-logo-text" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle p-1" style="width: 38px; height: 38px; background-color: var(--primary-blue-subtle) !important;">
                    <i class="bi bi-capsule" style="color: var(--primary-blue); font-size: 1.25rem;"></i>
                </span>
                <span>Roshetta</span>
            </a>

            <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#rosettaNavbar" aria-controls="rosettaNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="bi bi-list fs-2 text-dark"></i>
            </button>

            <div class="collapse navbar-collapse" id="rosettaNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-4 gap-1">
                    <li class="nav-item">
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Home" ? "active" : "")" asp-controller="Home" asp-action="Index">
                            <i class="bi bi-grid-fill"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Cart" ? "active" : "")" asp-controller="Cart" asp-action="Index">
                            <i class="bi bi-cart3"></i>
                            <span>My Cart</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link-custom @(ViewContext.RouteData.Values["controller"]?.ToString() == "Orders" ? "active" : "")" asp-controller="Orders" asp-action="Index">
                            <i class="bi bi-clock-history"></i>
                            <span>Orders & History</span>
                        </a>
                    </li>
                </ul>

                <!-- Right Actions: Cart Badge & Customer Profile -->
                <div class="d-flex align-items-center gap-3 mt-3 mt-lg-0">
                    <a asp-controller="Cart" asp-action="Index" class="cart-nav-btn" title="View Shopping Cart">
                        <i class="bi bi-bag"></i>
                        <span>Cart</span>
                    </a>

                    <div class="dropdown">
                        <button class="btn user-nav-pill dropdown-toggle shadow-none" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <div class="user-avatar-circle">
                                @(userName.Length > 0 ? userName.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <span class="d-none d-sm-inline">@userName</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-light" style="border-radius: var(--radius-sm);">
                            <li class="px-3 py-2 border-bottom">
                                <div class="fw-bold">@userName</div>
                                <div class="text-muted small">Customer Account</div>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-box-seam me-2 text-primary"></i>My Orders
                                </a>
                            </li>
                            <li>
                                <a class="dropdown-item py-2" asp-controller="Cart" asp-action="Index">
                                    <i class="bi bi-cart-check me-2 text-success"></i>Active Cart
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <!-- Flash Messages (Toasts / Alerts) -->
    <div class="container mt-3">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center shadow-sm" style="border-radius: var(--radius-sm); border-color: var(--success-green); background-color: var(--soft-green); color: #166534;" role="alert">
                <i class="bi bi-check-circle-fill fs-5 me-2" style="color: var(--success-green);"></i>
                <div class="fw-semibold">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center shadow-sm" style="border-radius: var(--radius-sm); border-color: #fca5a5; background-color: var(--soft-red); color: var(--critical-red);" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
                <div class="fw-semibold">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close shadow-none" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main role="main" class="pb-5">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="rosetta-footer">
        <div class="container">
            <div class="row g-4 align-items-center">
                <div class="col-md-6">
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="brand-logo-text fs-3">Roshetta</span>
                        <span class="brand-badge">DEPI Final Project</span>
                    </div>
                    <p class="text-secondary small mb-0">
                        Smart Online Pharmacy & Medication Management Platform. Designed for Egyptian users with licensed pharmacy oversight.
                    </p>
                </div>
                <div class="col-md-6 text-md-end text-secondary small">
                    <div>Module 3: Cart, Checkout & Customer Orders &bull; Fady Maged</div>
                    <div class="mt-1 text-muted">&copy; 2026 Roshetta Platform. Academic prototype with synthetic data.</div>
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Global helper to refresh cart badge asynchronously
        function refreshCartBadge() {
            $.get('/Cart/Count', function(data) {
                if (data && typeof data.count !== 'undefined') {
                    $('#navCartBadge').text(data.count);
                }
            });
        }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
