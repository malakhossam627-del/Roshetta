@model List<Rosetta.DAL.Entites.Pharmacy.Inventory>
@{
    ViewData["Title"] = "Dashboard";
    var userName = ViewBag.UserName as string ?? "Nourhan Gamal";
    var firstName = userName.Split(' ')[0];
}

<div class="container-fluid p-0">
    <!-- Greeting Header matching Image 1 -->
    <div class="mb-4">
        <h1 class="fw-bold mb-1" style="color: var(--dark-navy); font-size: 2.15rem; letter-spacing: -0.02em;">
            Hello, @firstName !
        </h1>
        <p class="mb-0" style="color: var(--text-secondary); font-size: 1.05rem; font-weight: 500;">
            Take care of your health with Roshetta
        </p>
    </div>

    <!-- 4 Stat Cards Row matching Image 1 -->
    <div class="row g-3 g-xl-4 mb-4">
        <!-- Card 1: Total Orders -->
        <div class="col-6 col-md-3">
            <a asp-controller="Orders" asp-action="Index" class="text-decoration-none d-block h-100">
                <div class="stat-card-mockup">
                    <div class="stat-circle-icon" style="background-color: #E0F2FE; color: #0284C7;">
                        <i class="bi bi-cart3"></i>
                    </div>
                    <div class="stat-val-mockup">3</div>
                    <div class="stat-label-mockup">Total Orders</div>
                </div>
            </a>
        </div>

        <!-- Card 2: Active Plans -->
        <div class="col-6 col-md-3">
            <a asp-controller="Home" asp-action="Medications" class="text-decoration-none d-block h-100">
                <div class="stat-card-mockup">
                    <div class="stat-circle-icon" style="background-color: #E0F7FA; color: #0F6B8D;">
                        <i class="bi bi-capsule"></i>
                    </div>
                    <div class="stat-val-mockup">2</div>
                    <div class="stat-label-mockup">Active Plans</div>
                </div>
            </a>
        </div>

        <!-- Card 3: Adherence Rate -->
        <div class="col-6 col-md-3">
            <div class="stat-card-mockup">
                <div class="stat-circle-icon" style="background-color: #DCFCE7; color: var(--success-green);">
                    <i class="bi bi-check-lg"></i>
                </div>
                <div class="stat-val-mockup">95%</div>
                <div class="stat-label-mockup">Adherence Rate</div>
            </div>
        </div>

        <!-- Card 4: Your Rating -->
        <div class="col-6 col-md-3">
            <div class="stat-card-mockup">
                <div class="stat-circle-icon" style="background-color: #FEF3C7; color: #F59E0B;">
                    <i class="bi bi-star-fill"></i>
                </div>
                <div class="stat-val-mockup">4.5</div>
                <div class="stat-label-mockup">Your Rating</div>
            </div>
        </div>
    </div>

    <!-- Lower Section: Today's Medications (Left) & Your Health Our Priority (Right) -->
    <div class="row g-4 mb-4">
        <!-- Left Card: Today's Medications -->
        <div class="col-lg-8">
            <div class="medications-card-mockup">
                <div class="medications-card-header">
                    <h2 class="medications-card-title">Today's Medications</h2>
                    <a asp-controller="Home" asp-action="Medications" class="medications-view-all">
                        <span>View All</span>
                        <i class="bi bi-arrow-right"></i>
                    </a>
                </div>

                <!-- Dose 1: Vitamin D (Taken) -->
                <div class="med-item-row">
                    <div>
                        <div class="med-item-name">Vitamin D</div>
                        <div class="med-item-meta">8:00 AM - 1 Tablet</div>
                    </div>
                    <div class="pill-toggle-taken" id="pillVitaminD">
                        <span>Taken</span>
                        <span class="circle-check-green">
                            <i class="bi bi-check-lg"></i>
                        </span>
                    </div>
                </div>

                <!-- Dose 2: Blood Pressure pill (Take) -->
                <div class="med-item-row">
                    <div>
                        <div class="med-item-name">Blood Pressure pill</div>
                        <div class="med-item-meta">8:00 AM - 1 Tablet</div>
                    </div>
                    <a href="javascript:void(0);" class="pill-toggle-take" id="pillBp" onclick="toggleDose(this)">
                        <span>Take</span>
                        <span class="circle-clock-blue">
                            <i class="bi bi-clock"></i>
                        </span>
                    </a>
                </div>
            </div>
        </div>

        <!-- Right Card: Your Health Our Priority -->
        <div class="col-lg-4">
            <div class="priority-card-mockup">
                <h3 class="priority-card-title">
                    Your Health<br>Our Priority
                </h3>
                <p class="priority-card-sub">
                    Smart tools for a healthier life
                </p>
                <div>
                    <a asp-controller="Home" asp-action="Pharmacy" class="btn btn-explore-gradient">
                        Explore Features
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Access: Pharmacy & Order section for testing Task 3 (Fady Maged) -->
    <div class="mt-4 pt-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h3 class="h5 fw-bold mb-0" style="color: var(--dark-navy);">Quick Order from Pharmacy</h3>
                <span class="text-secondary small">Add medicines directly to your cart & proceed to checkout</span>
            </div>
            <a asp-action="Pharmacy" class="btn btn-rosetta-outline btn-sm">
                Full Pharmacy <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-3">
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model.Take(3))
                {
                    <div class="col-md-4">
                        <div class="medicine-card p-3">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(item.Product.Medicine.PrescriptionType == "Rx" ? "badge-rx" : "badge-otc")">
                                    @item.Product.Medicine.PrescriptionType
                                </span>
                                <span class="text-secondary small fw-bold">EGP @item.UnitPrice.ToString("N2")</span>
                            </div>
                            <div class="fw-bold text-dark fs-6 mb-1">
                                @(item.Product.BrandNameEn ?? item.Product.Medicine.NameEn)
                            </div>
                            <div class="text-muted small mb-3">@item.Product.Strength &bull; @item.Product.DosageForm</div>

                            <form asp-controller="Cart" asp-action="Add" method="post" class="mt-auto add-to-cart-form">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="inventoryId" value="@item.InventoryId" />
                                <input type="hidden" name="quantity" value="1" />
                                <button type="submit" class="btn-add-cart-green">
                                    <i class="bi bi-cart-plus"></i> Add to Cart
                                </button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleDose(btn) {
            var $btn = $(btn);
            $btn.removeClass('pill-toggle-take').addClass('pill-toggle-taken');
            $btn.html('<span>Taken</span><span class="circle-check-green"><i class="bi bi-check-lg"></i></span>');
            $btn.removeAttr('onclick');
        }

        $(document).ready(function() {
            $('.add-to-cart-form').on('submit', function(e) {
                e.preventDefault();
                var form = $(this);
                var btn = form.find('button[type="submit"]');
                var originalHtml = btn.html();

                btn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm me-1" role="status"></span> Adding...');

                $.ajax({
                    url: form.attr('action'),
                    type: 'POST',
                    data: form.serialize(),
                    success: function(res) {
                        btn.prop('disabled', false).html('<i class="bi bi-check2"></i> Added!');
                        setTimeout(function() {
                            btn.html(originalHtml);
                        }, 2000);
                        refreshCartBadge();
                    },
                    error: function() {
                        btn.prop('disabled', false).html(originalHtml);
                        form.off('submit').submit();
                    }
                });
            });
        });
    </script>
}
