@model Roshetta.BLL.DTOs.OrderTrackingDto
@{
    ViewData["Title"] = "Track Order - " + Model.OrderNumber;
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-1 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Orders" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Orders</a></li>
            <li class="breadcrumb-item active" aria-current="page" style="color: var(--text-secondary);">Tracking</li>
        </ol>
    </nav>

    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <div class="d-flex align-items-center gap-2 mb-1">
                <h1 class="h3 fw-bold mb-0" style="color: var(--dark-navy);">Live Order Tracking</h1>
                <span class="rosetta-badge badge-status-placed" style="background-color: var(--primary-blue-subtle); color: var(--primary-blue);">
                    <i class="bi bi-broadcast"></i> Live
                </span>
            </div>
            <div class="text-secondary small">
                Order <strong class="text-dark">#@Model.OrderNumber</strong> &bull; Total: <strong>EGP @Model.TotalAmount.ToString("N2")</strong> (@Model.ItemsCount items)
            </div>
        </div>

        <div class="d-flex flex-wrap gap-2">
            <a asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-rosetta-secondary btn-sm">
                <i class="bi bi-receipt me-1"></i> View Order Details
            </a>
            <a asp-action="Index" class="btn btn-rosetta-outline btn-sm">
                <i class="bi bi-arrow-left me-1"></i> All Orders
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left: Live Tracking Stepper -->
        <div class="col-lg-8">
            <div class="rosetta-card p-4 mb-4">
                <!-- Delivery Banner -->
                <div class="p-3 mb-4 rounded-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="background-color: var(--secondary-blue-subtle); border-left: 4px solid var(--primary-blue);">
                    <div>
                        <span class="small text-secondary d-block">Estimated Courier Delivery:</span>
                        <div class="fw-bold fs-5" style="color: var(--dark-navy);">
                            <i class="bi bi-clock-history me-1" style="color: var(--primary-blue);"></i> @Model.EstimatedDelivery
                        </div>
                    </div>
                    <span class="badge" style="background-color: var(--soft-green); color: #166534; font-size: 0.85rem; padding: 6px 12px;">
                        On Schedule
                    </span>
                </div>

                <h2 class="h5 fw-bold mb-4" style="color: var(--dark-navy);">Delivery Progress Timeline</h2>

                <!-- Stepper -->
                <div class="tracking-stepper ps-2">
                    @foreach (var step in Model.Steps)
                    {
                        <div class="stepper-item @(step.IsCompleted ? "completed" : "") @(step.IsCurrent ? "current" : "")">
                            <div class="stepper-icon">
                                <i class="bi @step.IconClass"></i>
                            </div>
                            <div class="stepper-content">
                                <div class="d-flex justify-content-between align-items-center flex-wrap">
                                    <div class="stepper-title">@step.Title</div>
                                    @if (step.Timestamp.HasValue)
                                    {
                                        <div class="stepper-time">@step.Timestamp.Value.ToString("dd MMM yyyy, hh:mm tt")</div>
                                    }
                                </div>
                                <div class="stepper-desc">@step.Description</div>
                                @if (step.IsCurrent)
                                {
                                    <div class="mt-2">
                                        <span class="badge" style="background-color: var(--primary-blue); color: #fff; font-size: 0.75rem;">
                                            Current Stage
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Right: Destination & Pharmacy Details -->
        <div class="col-lg-4">
            <!-- Destination Card -->
            <div class="rosetta-card mb-4 p-3">
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-light">
                    <i class="bi bi-house-door-fill text-danger fs-5"></i>
                    <h3 class="h6 fw-bold mb-0 text-dark">Delivery Destination</h3>
                </div>
                <div class="small text-secondary mb-2">@Model.DeliveryAddress</div>
                <div class="p-2 rounded-2 small text-muted" style="background-color: var(--bg-app);">
                    <i class="bi bi-shield-check text-success me-1"></i> Contactless delivery requested. Courier will call upon arrival.
                </div>
            </div>

            <!-- Pharmacy Partner -->
            <div class="rosetta-card mb-4 p-3">
                <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom border-light">
                    <i class="bi bi-hospital text-primary fs-5"></i>
                    <h3 class="h6 fw-bold mb-0 text-dark">Dispensing Partner</h3>
                </div>
                <div class="fw-semibold text-dark small mb-1">@Model.PharmacyName</div>
                <div class="small text-secondary mb-2">Licensed & Monitored Pharmacy</div>
                <div class="d-grid">
                    <a href="tel:+20227361234" class="btn btn-rosetta-outline btn-sm">
                        <i class="bi bi-telephone me-1"></i> Contact Pharmacist
                    </a>
                </div>
            </div>

            <!-- Need Help? -->
            <div class="rosetta-card p-3" style="background-color: var(--primary-blue-subtle); border-color: rgba(15, 107, 141, 0.2);">
                <div class="d-flex align-items-center gap-2 mb-1">
                    <i class="bi bi-headset fs-5" style="color: var(--primary-blue);"></i>
                    <h4 class="h6 fw-bold mb-0" style="color: var(--dark-navy);">Have a question?</h4>
                </div>
                <p class="small text-secondary mb-3">
                    If you need to update delivery notes, check interaction warnings, or speak with our clinical support team, we are here 24/7.
                </p>
                <a href="mailto:support@roshetta.eg" class="btn btn-rosetta-primary btn-sm w-100">
                    <i class="bi bi-envelope me-1"></i> Email Support
                </a>
            </div>
        </div>
    </div>
</div>
