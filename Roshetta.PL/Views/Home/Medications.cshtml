@{
    ViewData["Title"] = "My Medication Plan";
}

<div>
    <!-- Header (Wireframe - 5) -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h1 class="h3 fw-bold mb-1" style="color: var(--dark-navy);">My Medication Plan</h1>
            <p class="text-secondary small mb-0">Track your daily prescribed regimen and build your adherence history.</p>
        </div>
        <button class="btn btn-rosetta-primary btn-sm px-3" onclick="alert('Module B: Smart Medication Reminder allows adding custom schedules & refill alerts.');">
            <i class="bi bi-plus-lg me-1"></i> Add New Plan
        </button>
    </div>

    <!-- Day Selector Tabs (Wireframe - 5) -->
    <div class="d-flex gap-2 overflow-auto pb-2 mb-4">
        <button class="btn btn-rosetta-primary btn-sm px-3 py-2 fw-bold" style="border-radius: var(--radius-pill);">Today</button>
        <button class="btn btn-light border btn-sm px-3 py-2 text-secondary" style="border-radius: var(--radius-pill);">Mon 17 Nov</button>
        <button class="btn btn-light border btn-sm px-3 py-2 text-secondary" style="border-radius: var(--radius-pill);">Tue 18 Nov</button>
        <button class="btn btn-light border btn-sm px-3 py-2 text-secondary" style="border-radius: var(--radius-pill);">Wed 19 Nov</button>
        <button class="btn btn-light border btn-sm px-3 py-2 text-secondary" style="border-radius: var(--radius-pill);">Thu 20 Nov</button>
        <button class="btn btn-light border btn-sm px-3 py-2 text-secondary" style="border-radius: var(--radius-pill);">Fri 21 Nov</button>
        <button class="btn btn-light border btn-sm px-3 py-2 text-secondary" style="border-radius: var(--radius-pill);">Sat 22 Nov</button>
    </div>

    <div class="row g-4">
        <!-- Medication Schedule List (Wireframe - 5) -->
        <div class="col-lg-8">
            <!-- Dose 1: Taken -->
            <div class="rosetta-card p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background-color: var(--success-green); font-size: 1.4rem;">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-6 text-dark">Vitamin D3 - 1000 IU</div>
                        <div class="text-secondary small">1 Capsule &bull; After Breakfast &bull; 09:00 AM</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge" style="background-color: var(--soft-green); color: #166534; padding: 6px 14px; font-size: 0.85rem;">
                        Taken (09:12 AM)
                    </span>
                </div>
            </div>

            <!-- Dose 2: Pending / Actionable -->
            <div class="rosetta-card p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2" style="border-color: #fca5a5;">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white" style="width: 44px; height: 44px; background-color: var(--critical-red); font-size: 1.2rem;">
                        <i class="bi bi-exclamation"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-6 text-dark">Concor 5mg (Blood Pressure)</div>
                        <div class="text-secondary small">1 Tablet &bull; Scheduled at 02:00 PM &bull; Pharmacist Supervised</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <button class="btn btn-rosetta-danger btn-sm px-3" onclick="$(this).replaceWith('<span class=\'badge bg-success\'>Taken</span>');">
                        Take Now
                    </button>
                    <button class="btn btn-light border btn-sm px-2 text-muted" title="Snooze reminder">
                        <i class="bi bi-bell-slash"></i>
                    </button>
                </div>
            </div>

            <!-- Dose 3: Evening -->
            <div class="rosetta-card p-3 mb-3 d-flex align-items-center justify-content-between flex-wrap gap-2">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center text-muted" style="width: 44px; height: 44px; background-color: var(--bg-app); border: 2px dashed var(--border-color); font-size: 1.2rem;">
                        <i class="bi bi-moon-stars"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-6 text-dark">Limitless Omega 3</div>
                        <div class="text-secondary small">1 Softgel &bull; After Dinner &bull; 08:30 PM</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-light text-secondary border">Upcoming</span>
                </div>
            </div>
        </div>

        <!-- Right Side: Health Priority Banner -->
        <div class="col-lg-4">
            <div class="rosetta-card p-4 text-white" style="background: linear-gradient(135deg, var(--dark-navy) 0%, var(--primary-blue) 100%);">
                <h3 class="h5 fw-bold text-white mb-2">Need a Refill?</h3>
                <p class="small text-white-50 mb-3" style="line-height: 1.5;">
                    When your supply drops below 5 doses, Roshetta automatically alerts you to reorder from your designated pharmacy.
                </p>
                <a asp-action="Pharmacy" class="btn btn-rosetta-success btn-sm w-100 fw-bold">
                    <i class="bi bi-arrow-repeat me-1"></i> Refill Prescriptions
                </a>
            </div>
        </div>
    </div>
</div>
