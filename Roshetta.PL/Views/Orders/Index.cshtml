@model List<Roshetta.BLL.DTOs.OrderSummaryDto>
@{
    ViewData["Title"] = "Customer Orders";
    var activeFilter = ViewBag.ActiveFilter as string ?? "All";
}

<div class="container py-4">
    <!-- Breadcrumb & Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1 small">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none" style="color: var(--primary-blue);">Home</a></li>
                    <li class="breadcrumb-item active" aria-current="page" style="color: var(--text-secondary);">Orders</li>
                </ol>
            </nav>
            <h1 class="h3 fw-bold mb-0" style="color: var(--dark-navy);">
                My Orders & History
                <span class="badge rounded-pill ms-2" style="background-color: var(--primary-blue-subtle); color: var(--primary-blue); font-size: 0.85rem;">@Model.Count @(Model.Count == 1 ? "Order" : "Orders")</span>
            </h1>
        </div>

        <a asp-controller="Home" asp-action="Index" class="btn btn-rosetta-primary">
            <i class="bi bi-plus-circle me-1"></i> New Medication Order
        </a>
    </div>

    <!-- Filter Tabs (Design System Pills) -->
    <div class="d-flex flex-wrap gap-2 mb-4 p-1 rounded-pill bg-white border border-light shadow-sm d-inline-flex">
        <a asp-action="Index" asp-route-status="All" class="order-filter-tab @(activeFilter == "All" ? "active" : "")">
            <i class="bi bi-collection me-1"></i> All Orders
        </a>
        <a asp-action="Index" asp-route-status="Active" class="order-filter-tab @(activeFilter == "Active" ? "active" : "")">
            <i class="bi bi-hourglass-split me-1"></i> Active / In-Progress
        </a>
        <a asp-action="Index" asp-route-status="Delivered" class="order-filter-tab @(activeFilter == "Delivered" ? "active" : "")">
            <i class="bi bi-check2-circle me-1"></i> Delivered
        </a>
        <a asp-action="Index" asp-route-status="Cancelled" class="order-filter-tab @(activeFilter == "Cancelled" ? "active" : "")">
            <i class="bi bi-x-circle me-1"></i> Cancelled
        </a>
    </div>

    @if (Model.Count == 0)
    {
        <!-- Empty Orders State -->
        <div class="empty-state-box">
            <div class="empty-state-icon">
                <i class="bi bi-bag-x"></i>
            </div>
            <h3 class="h4 fw-bold" style="color: var(--dark-navy);">No orders found</h3>
            <p class="text-secondary mx-auto mb-4" style="max-width: 440px;">
                You don't have any orders matching the selected filter. You can browse the pharmacy catalog to place your first order.
            </p>
            <a asp-controller="Home" asp-action="Index" class="btn btn-rosetta-primary px-4 py-2">
                <i class="bi bi-capsule me-1"></i> Browse Medications
            </a>
        </div>
    }
    else
    {
        <!-- Orders List -->
        <div class="row g-3">
            @foreach (var order in Model)
            {
                <div class="col-12">
                    <div class="rosetta-card p-3 p-md-4">
                        <div class="row align-items-center g-3">
                            <!-- Left: Order Info & Status -->
                            <div class="col-lg-5 col-md-6">
                                <div class="d-flex align-items-center gap-2 mb-1">
                                    <span class="fw-bold fs-6" style="color: var(--dark-navy);">@order.OrderNumber</span>

                                    <!-- Status Pill with Palette Tokens -->
                                    @if (order.Status == "Placed")
                                    {
                                        <span class="rosetta-badge badge-status-placed"><i class="bi bi-bag-check"></i> Placed</span>
                                    }
                                    else if (order.Status.Contains("Review"))
                                    {
                                        <span class="rosetta-badge badge-status-review"><i class="bi bi-clipboard-pulse"></i> Rx Review</span>
                                    }
                                    else if (order.Status == "Confirmed")
                                    {
                                        <span class="rosetta-badge badge-status-confirmed"><i class="bi bi-check-circle"></i> Confirmed</span>
                                    }
                                    else if (order.Status == "Packed")
                                    {
                                        <span class="rosetta-badge badge-status-packed"><i class="bi bi-box-seam"></i> Packed</span>
                                    }
                                    else if (order.Status.Contains("Delivery") || order.Status.Contains("Out"))
                                    {
                                        <span class="rosetta-badge badge-status-delivery"><i class="bi bi-truck"></i> Out for Delivery</span>
                                    }
                                    else if (order.Status == "Delivered")
                                    {
                                        <span class="rosetta-badge badge-status-delivered"><i class="bi bi-check-all"></i> Delivered</span>
                                    }
                                    else
                                    {
                                        <span class="rosetta-badge badge-status-cancelled"><i class="bi bi-x-circle"></i> @order.Status</span>
                                    }
                                </div>

                                <div class="text-muted small">
                                    <i class="bi bi-calendar3 me-1"></i> @order.OrderDate.ToString("dd MMM yyyy, hh:mm tt")
                                </div>
                                <div class="text-secondary small mt-1">
                                    <i class="bi bi-hospital me-1 text-primary"></i> @order.PharmacyName
                                </div>
                            </div>

                            <!-- Middle: Items Preview & Total -->
                            <div class="col-lg-4 col-md-6">
                                <div class="small fw-semibold text-dark">
                                    @order.FirstItemName
                                    @if (order.ItemsCount > 1)
                                    {
                                        <span class="text-muted fw-normal">and @(order.ItemsCount - 1) more item(s)</span>
                                    }
                                </div>
                                <div class="d-flex align-items-baseline gap-2 mt-1">
                                    <span class="text-secondary small">Total Amount:</span>
                                    <span class="fw-bold fs-6" style="color: var(--primary-blue);">EGP @order.TotalAmount.ToString("N2")</span>
                                    <span class="badge bg-light text-secondary border border-light small">Cash on Delivery</span>
                                </div>
                            </div>

                            <!-- Right: Actions -->
                            <div class="col-lg-3 col-12 d-flex flex-wrap justify-content-lg-end gap-2">
                                <a asp-action="Track" asp-route-id="@order.OrderId" class="btn btn-rosetta-primary btn-sm" title="Track Live Order">
                                    <i class="bi bi-geo-alt-fill"></i> Track
                                </a>

                                <a asp-action="Details" asp-route-id="@order.OrderId" class="btn btn-rosetta-secondary btn-sm" title="View Full Order Details">
                                    <i class="bi bi-receipt"></i> Details
                                </a>

                                <form asp-action="Reorder" asp-route-id="@order.OrderId" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-rosetta-outline btn-sm" title="Add all items from this order to cart">
                                        <i class="bi bi-arrow-repeat"></i> Reorder
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
