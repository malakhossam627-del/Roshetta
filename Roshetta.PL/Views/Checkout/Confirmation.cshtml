@model Roshetta.BLL.DTOs.OrderConfirmationDto
@{
    ViewData["Title"] = "Order Confirmation";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Order Success Banner -->
            <div class="rosetta-card text-center p-4 p-md-5 mb-4 shadow-sm" style="border-top: 5px solid var(--success-green);">
                <div class="rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 72px; height: 72px; background-color: var(--soft-green); color: var(--success-green);">
                    <i class="bi bi-check-lg" style="font-size: 2.5rem;"></i>
                </div>

                <h1 class="h3 fw-bold mb-2" style="color: var(--dark-navy);">Order Placed Successfully!</h1>
                <p class="text-secondary mx-auto mb-4" style="max-width: 500px;">
                    Thank you, <strong>@Model.CustomerName</strong>. Your order has been placed with <strong>Roshetta Partner Pharmacy</strong> and is being processed.
                </p>

                <!-- Order Number Badge -->
                <div class="d-inline-flex align-items-center gap-2 p-2 px-3 rounded-pill mb-4" style="background-color: var(--primary-blue-subtle); border: 1px dashed var(--primary-blue);">
                    <span class="text-secondary small fw-semibold">Order Number:</span>
                    <strong class="fs-6" style="color: var(--primary-blue);">@Model.OrderNumber</strong>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap justify-content-center gap-3">
                    <a asp-controller="Orders" asp-action="Track" asp-route-id="@Model.OrderId" class="btn btn-rosetta-primary px-4 py-2">
                        <i class="bi bi-geo-alt-fill me-1"></i> Track Order Live
                    </a>
                    <a asp-controller="Orders" asp-action="Details" asp-route-id="@Model.OrderId" class="btn btn-rosetta-secondary px-4 py-2">
                        <i class="bi bi-receipt me-1"></i> View Order Details
                    </a>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-rosetta-outline px-4 py-2">
                        <i class="bi bi-shop me-1"></i> Back to Pharmacy
                    </a>
                </div>
            </div>

            <!-- Order Details Card -->
            <div class="rosetta-card mb-4">
                <div class="rosetta-card-header d-flex justify-content-between align-items-center">
                    <h2 class="h6 fw-bold mb-0" style="color: var(--dark-navy);">Order Summary & Delivery Information</h2>
                    <span class="badge" style="background-color: var(--soft-green); color: #166534;">Cash on Delivery</span>
                </div>
                <div class="rosetta-card-body">
                    <div class="row g-3 mb-4">
                        <div class="col-sm-6">
                            <span class="small text-secondary d-block">Estimated Arrival:</span>
                            <span class="fw-bold" style="color: var(--dark-navy);"><i class="bi bi-clock me-1 text-primary"></i> @Model.EstimatedDelivery</span>
                        </div>
                        <div class="col-sm-6">
                            <span class="small text-secondary d-block">Payment Method:</span>
                            <span class="fw-bold" style="color: var(--dark-navy);"><i class="bi bi-cash-stack me-1 text-success"></i> @Model.PaymentMethod</span>
                        </div>
                        <div class="col-12">
                            <span class="small text-secondary d-block">Delivery Address:</span>
                            <span class="fw-semibold text-dark"><i class="bi bi-pin-map me-1 text-danger"></i> @Model.DeliveryAddress</span>
                        </div>
                    </div>

                    <!-- Purchased Items -->
                    <h3 class="h6 fw-bold mb-3 border-top pt-3" style="color: var(--dark-navy);">Items in this order</h3>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <tbody>
                                @foreach (var item in Model.Items)
                                {
                                    <tr class="border-bottom border-light">
                                        <td class="ps-0 py-2">
                                            <div class="fw-semibold text-dark">@item.ProductName</div>
                                            <div class="text-muted small">@item.Strength &bull; @item.DosageForm</div>
                                        </td>
                                        <td class="text-center py-2 text-secondary">
                                            Qty: <strong>@item.Quantity</strong>
                                        </td>
                                        <td class="text-end pe-0 py-2 fw-semibold" style="color: var(--primary-blue);">
                                            EGP @((item.Quantity * item.UnitPrice).ToString("N2"))
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot>
                                <tr>
                                    <td colspan="2" class="ps-0 pt-3 fw-bold fs-6 text-dark">Total Amount Due</td>
                                    <td class="text-end pe-0 pt-3 fw-bold fs-5" style="color: var(--primary-blue);">
                                        EGP @Model.TotalAmount.ToString("N2")
                                    </td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            @if (Model.RequiresRxReview)
            {
                <div class="alert alert-info d-flex align-items-center gap-3 shadow-sm" style="border-radius: var(--radius-sm); border-color: rgba(77, 182, 217, 0.3); background-color: var(--secondary-blue-subtle); color: var(--dark-navy);">
                    <i class="bi bi-info-circle-fill fs-4" style="color: var(--primary-blue);"></i>
                    <div class="small">
                        <strong>Prescription Verification:</strong> A licensed pharmacist from our partner pharmacy will review your prescription details before courier dispatch. You can track this in real-time under <a asp-controller="Orders" asp-action="Track" asp-route-id="@Model.OrderId" class="fw-bold text-decoration-underline" style="color: var(--primary-blue);">Live Tracking</a>.
                    </div>
                </div>
            }
        </div>
    </div>
</div>
